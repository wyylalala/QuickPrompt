{
  "name": "dsh-quickprompt",
  "version": "0.2.0",
  "description": "炼化 Prompt 并一键执行：把口语需求变成结构化提示词，保存成快捷命令，随时复跑。A DSH plugin that forges rough requests into reusable prompts and runs them in one click.",
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-library",
    "prompt-management",
    "quickprompt"
  ],
  "license": "MIT",
  "author": "wyylalala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyylalala/QuickPrompt.git"
  },
  "homepage": "https://github.com/wyylalala/QuickPrompt#readme",
  "bugs": {
    "url": "https://github.com/wyylalala/QuickPrompt/issues"
  },
  "scripts": {
    "test": "node test/render.test.js && node test/plugin.test.js && node test/client.test.js",
    "test:render": "node test/render.test.js",
    "test:plugin": "node test/plugin.test.js",
    "test:client": "node test/client.test.js",
    "check:leaks": "node tools/check-leaks.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
